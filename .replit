modules = ["nodejs-20", "web", "bun-1.3", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "for node_bin in /nix/store/*-nodejs-20.*-wrapped/bin; do if [ -x \"$node_bin/npm\" ]; then PATH=\"$node_bin:$PATH\"; break; fi; done; exec npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

