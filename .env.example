# Set these in your VPS service environment or a private, untracked .env file.
DATABASE_URL=
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
SESSION_SECRET=
PORT=5000
NODE_ENV=production
# Set NODE_ENV=development and DB_PUSH_TARGET=development in the shell for a development schema push.
DB_PUSH_TARGET=
# Production pushes additionally require DB_PUSH_CONFIRM_PRODUCTION=YES.
DB_PUSH_CONFIRM_PRODUCTION=