# Local-only template. Copy to .env for local development; never commit .env.
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=
SESSION_SECRET=

# Replit provides DATABASE_URL for the connected PostgreSQL database.
# For local development, set DATABASE_URL in an untracked .env file.
# Set this guard only when DATABASE_URL points to a local/development database.
DB_PUSH_TARGET=development
# DATABASE_URL=
